<?xml version="1.0"?>
<info xmlns:xsi= "http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>occweb</id>
    <name>Extended OCC Web</name>
    <summary>OCC Commands in a web terminal</summary>
    <description><![CDATA[Run OCC Commands in a web terminal]]></description>
    <version>0.3.4</version>
    <licence>agpl</licence>
    <author mail="dillard.blom@ensembia.com" >Dillard Blom</author>
    <namespace>OCCWeb</namespace>
    <category>tools</category>
    <website>https://github.com/dillardblom/occweb</website>
    <bugs>https://github.com/dillardblom/occweb/issues</bugs>
    <repository>https://github.com/dillardblom/occweb</repository>
    <screenshot>https://github.com/dillardblom/occweb/raw/main/appinfo/screenshot.png</screenshot>
    <dependencies>
        <!-- max-version must equal the highest NC core version this fork has
             actually been verified on - never a value inherited from upstream
             or guessed ahead. Test against the next major's beta and bump
             this BEFORE it goes final, so occ:upgrade never has to fall back
             to auto-disabling the app. -->
        <nextcloud min-version="30" max-version="33"/>
    </dependencies>
    <navigations>
        <navigation role="admin">
            <name>OCCWeb</name>
            <route>occweb.occ.index</route>
            <icon>app.svg</icon>
            <type>link</type>
        </navigation>
    </navigations>
</info>
